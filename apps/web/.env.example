# PlayMe web environment variables. Copy to .env.local for local dev.

# URL of the PlayMe API.
#   - local dev:  http://localhost:5080 (see infra/docker-compose)
#   - production: in Vercel, set both PLAYME_API_URL (SSR) and
#                 NEXT_PUBLIC_API_URL (browser) to https://api.playme.ge
PLAYME_API_URL=http://localhost:5080
# NEXT_PUBLIC_API_URL is read in the browser bundle for direct API/SignalR calls.
# Leave unset for local dev (the web proxies through PLAYME_API_URL); required in prod.
NEXT_PUBLIC_API_URL=

# Public Sentry DSN (web bundle). One per Sentry project.
NEXT_PUBLIC_SENTRY_DSN=

# Public PostHog project key + host. EU cloud by default.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
