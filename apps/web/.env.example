# PlayMe web environment variables. Copy to .env.local for local dev.

# Direct URL to the PlayMe API upstream (Azure App Service in prod).
# Used by:
#   - SSR fetches (server-to-server, no cookies, fastest path).
#   - The next.config.js rewrites — both the path-based /api/*, /hubs/*
#     proxies and the optional hostname-conditioned proxy below.
# Local dev: http://localhost:5080.
# Prod: https://playme-api-prod.azurewebsites.net (the direct Azure host).
PLAYME_API_URL=http://localhost:5080

# Browser-facing API base URL — what fetch() and the SignalR client see.
# Leave unset/empty in local dev so the browser falls back to relative paths
# served by the web origin (the path-based rewrites then forward to PLAYME_API_URL).
# In prod set this to https://api.playme.ge — Vercel claims that domain on
# this project and PLAYME_API_PROXY_HOST below makes the host-based rewrite
# forward requests to PLAYME_API_URL. Browser thus sees only *.playme.ge,
# keeping cookies first-party.
NEXT_PUBLIC_API_URL=

# Hostname that the host-based rewrite in next.config.js intercepts.
# When set (prod), all requests arriving at this host are proxied to
# PLAYME_API_URL. Vercel must already claim this hostname as a domain of
# this project — it serves TLS via a Let's Encrypt cert it issues itself.
# Leave unset in local dev (the path-based rewrites cover that case).
# Prod: api.playme.ge.
PLAYME_API_PROXY_HOST=

# Public Sentry DSN (web bundle). One per Sentry project.
NEXT_PUBLIC_SENTRY_DSN=

# Public PostHog project key + host. EU cloud by default.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
