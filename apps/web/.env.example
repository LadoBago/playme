# PlayMe web environment variables. Copy to .env.local for local dev.

# Direct URL to the PlayMe API upstream (Azure App Service in prod).
# Used by:
#   - SSR fetches (server-to-server, no cookies, fastest path).
#   - The next.config.js path-based /api/* and /hubs/* rewrites in local dev.
# Local dev: http://localhost:5080.
# Prod: the direct Azure origin (https://playme-api-prod2.azurewebsites.net),
# OR — preferred — https://api.playme.ge so SSR routes through Cloudflare like
# the client does. The latter decouples the web from the Azure origin hostname:
# pinning the direct origin here means a rename/migration breaks SSR with
# getaddrinfo ENOTFOUND (see docs/deployment.md §6.13).
PLAYME_API_URL=http://localhost:5080

# Browser-facing API base URL — what fetch() and the SignalR client see.
# Local dev: leave unset/empty so the browser uses relative paths served
# by the web origin (the path-based rewrites then forward to PLAYME_API_URL).
# Prod: https://api.playme.ge — that subdomain is served by Cloudflare
# (proxied CNAME → playme-api-prod2.azurewebsites.net), giving us first-party
# TLS and shared eTLD+1 with playme.ge so the session cookie stays
# same-site with SameSite=Lax.
NEXT_PUBLIC_API_URL=

# Public Sentry DSN (web bundle). One per Sentry project.
NEXT_PUBLIC_SENTRY_DSN=

# Public PostHog project key + host. EU cloud by default.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
