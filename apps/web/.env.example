# PlayMe web environment variables. Copy to .env.local for local dev.

# URL of the PlayMe API. Local dev runs the API on :5080 (see infra/docker-compose).
PLAYME_API_URL=http://localhost:5080

# Public Sentry DSN (web bundle). Optional in Sprint 0.
# NEXT_PUBLIC_SENTRY_DSN=

# Public PostHog project key. Optional in Sprint 0.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
