<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PlayMe.Application</RootNamespace>
    <AssemblyName>PlayMe.Application</AssemblyName>
    <!--
      CLAUDE.md §2.4: Application references only Domain. No infrastructure
      or framework references. Third-party SDKs forbidden (FluentValidation
      OK — it's a library, not a service adapter, per common practice; the
      rule is no service-adapter SDKs).
    -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PlayMe.Domain\PlayMe.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <!--
      Pure-interface logging package (no provider, no console sink). Lets
      Application handlers inject ILogger<T> per CLAUDE.md §6 without
      pulling in a logging implementation; concrete providers (Serilog,
      OTel) are wired in Infrastructure / Api.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
