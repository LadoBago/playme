# Inputs for infra/provision.sh. Copy to infra/provision.env and fill in.
# infra/provision.env is gitignored — never commit it.

# Azure subscription that owns the production stack.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Region. Italy North is ~50ms from Tbilisi; full SKU coverage for B1 + Redis Basic.
LOCATION=italynorth

# Resource names. The web app's *.azurewebsites.net hostname and the Azure
# Managed Redis *.<region>.redis.azure.net hostname are globally unique — bump
# the suffix if a name is taken. NOTE: deleting these names then recreating
# them in a DIFFERENT tenant is blocked — App Service soft-deletes the name for
# ~30 days (no purge), and Redis rejects cross-tenant name reuse outright. The
# current prod stack carries the `2` suffix for exactly this reason (see
# docs/deployment.md §6.13).
RG=playme-prod-rg
PLAN=playme-prod-plan
WEBAPP=playme-api-prod2
REDIS=playme-prod-redis2

# Public hostname for the API. Requires a CNAME + TXT verification record at
# your DNS provider — the script prints the exact records and pauses.
API_HOSTNAME=api.playme.ge

# Production web origin allowed by CORS (must include scheme, no trailing slash).
WEB_ORIGIN=https://playme.ge

# GitHub repo that will deploy via OIDC.
GITHUB_OWNER=LadoBago
GITHUB_REPO=playme

# Where production alerts (Sentry, App Service health, Redis availability) land.
ALERT_EMAIL=you@example.com

# Public GHCR image the App Service runs. Lowercase owner; tag is set by CI.
GHCR_IMAGE=ghcr.io/ladobago/playme-api

# Telemetry secrets — propagated to the App Service as `Sentry__Dsn` and
# `PostHog__ApiKey`. Leave empty to disable that integration; the API and
# the Sentry SDK both treat empty values as "disabled" (no crash, no events).
# This file is the source of truth — values added in the Azure Portal will
# be overwritten on the next provision.sh run. See docs/deployment.md §6.12.

# Sentry DSN for the API project (Sentry → Settings → Projects → playme-api
# → Client Keys). Form: https://<key>@<org>.ingest.sentry.io/<project-id>.
SENTRY_DSN=

# PostHog project API key for the API. Same phc_… capture-only project key
# the web bundle uses (NEXT_PUBLIC_POSTHOG_KEY on Vercel). Not a personal
# API key.
POSTHOG_API_KEY=
