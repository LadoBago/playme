# Inputs for infra/provision.sh. Copy to infra/provision.env and fill in.
# infra/provision.env is gitignored — never commit it.

# Azure subscription that owns the production stack.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Region. Italy North is ~50ms from Tbilisi; full SKU coverage for B1 + Redis Basic.
LOCATION=italynorth

# Resource names. Web app names are globally unique across Azure — change the
# suffix if `playme-api-prod` is already taken.
RG=playme-prod-rg
PLAN=playme-prod-plan
WEBAPP=playme-api-prod
REDIS=playme-prod-redis

# Public hostname for the API. Requires a CNAME + TXT verification record at
# your DNS provider — the script prints the exact records and pauses.
API_HOSTNAME=api.playme.ge

# Production web origin allowed by CORS (must include scheme, no trailing slash).
WEB_ORIGIN=https://playme.ge

# GitHub repo that will deploy via OIDC.
GITHUB_OWNER=LadoBago
GITHUB_REPO=playme

# Where production alerts (Sentry, App Service health, Redis availability) land.
ALERT_EMAIL=you@example.com

# Public GHCR image the App Service runs. Lowercase owner; tag is set by CI.
GHCR_IMAGE=ghcr.io/ladobago/playme-api
